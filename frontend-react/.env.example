# ============================================
# QR-UTP-RS - Environment Configuration Template
# ============================================
# Copia este archivo a .env.local para desarrollo local
# o a .env.production para configuración de producción

# -----------------------------------------------------------------
# API Principal (Backend Principal)
# -----------------------------------------------------------------
# URL base del servidor API principal
# Desarrollo local: http://localhost:8080
# Producción (Railway): https://tu-app.up.railway.app
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------
# Microservicio de Reconocimiento Facial
# -----------------------------------------------------------------
# URL base del microservicio de rostros
# Desarrollo local: http://localhost:5001
# Producción: https://tu-microservicio.up.railway.app (cuando esté disponible)
VITE_FACE_API_URL=http://localhost:5001

# -----------------------------------------------------------------
# Notas importantes sobre Vite:
# -----------------------------------------------------------------
# - Las variables deben comenzar con VITE_ para ser expuestas al cliente
# - Se acceden en el código mediante: import.meta.env.VITE_NOMBRE_VARIABLE
# - No es necesario instalar dotenv, Vite lo maneja automáticamente
# - Para desarrollo: npm run dev (usa .env.development)
# - Para producción: npm run build (usa .env.production)
